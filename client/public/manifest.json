{
  "name": "GyaanSetu",
  "short_name": "GyaanSetu",
  "description": "AI-powered learning platform for CBSE & ICSE students (Classes 4-12). Features AI lectures, video lessons, tests, and gamification.",
  "start_url": "/",
  "scope": "/",
  "id": "https://gyaansetu-five.vercel.app",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui", "window-controls-overlay", "tabbed"],
  "background_color": "#f97316",
  "theme_color": "#f97316",
  "orientation": "portrait-primary",
  "categories": ["education", "productivity", "utilities", "books", "study"],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/notes"
  },
  "tabbed_display": {
    "home_tab": { "scope": "/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    "new_tab_url": "/"
  },
  "related_applications": [
    { "platform": "play", "id": "com.gyaansetu.app", "url": "https://play.google.com/store/apps/details?id=com.gyaansetu.app" }
  ],
  "iarc_rating_id": "e10f0a1d-1e2a-4b3c-8d9e-0f1a2b3c4d5e",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "scope_extensions": [
    { "origin": "https://gyaansetu-five.vercel.app" },
    { "origin": "https://gyaansetu-8b44.onrender.com" }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gyaansetu",
      "url": "/?q=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Study Progress",
      "tag": "progress",
      "description": "Quick view of your study progress",
      "ms_ac_template": "custom"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "text/*": [".txt", ".md"], "application/pdf": [".pdf"], "image/*": [".png", ".jpg"] }
    }
  ],
  "shortcuts": [
    {
      "name": "Syllabus",
      "short_name": "Syllabus",
      "description": "Browse chapters and track progress",
      "url": "/syllabus",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Doubt Solver",
      "short_name": "Doubt",
      "description": "Ask Gyaan Guru anything",
      "url": "/doubt-solver",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Study Timer",
      "short_name": "Timer",
      "description": "Pomodoro focus sessions",
      "url": "/timer",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Whiteboard",
      "short_name": "Draw",
      "description": "Doodle and scribble",
      "url": "/whiteboard",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    { "src": "/screenshot1.png", "sizes": "1833x795", "type": "image/png", "form_factor": "wide", "label": "Home page" },
    { "src": "/screenshot2.png", "sizes": "787x866", "type": "image/png", "form_factor": "narrow", "label": "Profile page" },
    { "src": "/screenshot3.png", "sizes": "1048x879", "type": "image/png", "form_factor": "narrow", "label": "Videos" },
    { "src": "/screenshot4.png", "sizes": "1881x883", "type": "image/png", "form_factor": "wide", "label": "Syllabus" },
    { "src": "/screenshot5.png", "sizes": "1856x882", "type": "image/png", "form_factor": "wide", "label": "Analytics" }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
